# The CORE instance this satellite talks to.
ADIBILIS_BASE_URL=https://erp.example.ch

# The WEBSITE API key.
#
# SERVER-SIDE ONLY. Never prefix this NEXT_PUBLIC_ — anything so prefixed is inlined into the
# browser bundle and served to every visitor. The key is read exclusively in src/lib/adibilis.ts,
# which is only ever imported from route handlers; @adbls/sdk/server itself refuses to load in a
# browser bundle, so a client component importing it fails the build rather than shipping the key.
ADIBILIS_API_KEY=
