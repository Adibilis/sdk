{
    "name": "@adbls/sdk",
    "version": "0.5.0",
    "description": "Shop-site SDK for Adibilis CORE: server-side API client, zod form layer, cart/checkout, holidays.",
    "license": "Apache-2.0",
    "packageManager": "pnpm@11.23.0",
    "type": "module",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/client-entry.d.ts",
            "default": "./dist/client-entry.js"
        },
        "./server": {
            "browser": "./dist/server-in-browser-error.js",
            "types": "./dist/server.d.ts",
            "default": "./dist/server.js"
        },
        "./checkout": {
            "types": "./dist/checkout-entry.d.ts",
            "default": "./dist/checkout-entry.js"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "dependencies": {
        "@adbls/api-types": "0.0.0-dev.899"
    },
    "peerDependencies": {
        "react": ">=19",
        "zod": "^4.1.12"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.2",
        "@types/react": "^19",
        "jsdom": "^30.0.1",
        "react-dom": "^19.2.8",
        "typescript": "^5",
        "vitest": "^4.1.10"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "vitest run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Adibilis/sdk.git"
    },
    "homepage": "https://github.com/Adibilis/sdk"
}
